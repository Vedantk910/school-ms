# Copy to .env for docker-compose. All vars use the SCHOOLMS_ prefix.

# Postgres connection (compose wires db service to this)
SCHOOLMS_DATABASE_URL=postgresql+psycopg://schoolms:schoolms@db:5432/schoolms

# Change this in any real deployment
SCHOOLMS_JWT_SECRET=dev-secret-change-me

# LLM adapter: demo (offline, zero-cost, default) | ollama | openrouter
SCHOOLMS_LLM_BACKEND=demo

# Optional when LLM_BACKEND=ollama
SCHOOLMS_OLLAMA_BASE_URL=http://localhost:11434

# Optional when LLM_BACKEND=openrouter
SCHOOLMS_OPENROUTER_API_KEY=
SCHOOLMS_OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# Deterministic seed
SCHOOLMS_SEED=42
