# Copy to .env for docker-compose. All vars use the SCHOOLMS_ prefix.

# Postgres connection (compose wires db service to this)
SCHOOLMS_DATABASE_URL=postgresql+psycopg://schoolms:schoolms@db:5432/schoolms

# Change this in any real deployment
SCHOOLMS_JWT_SECRET=dev-secret-change-me

# LLM adapter: demo (offline, zero-cost, default) | ollama | openrouter
SCHOOLMS_LLM_BACKEND=demo

# Optional when LLM_BACKEND=ollama
SCHOOLMS_OLLAMA_BASE_URL=http://localhost:11434

# Optional when LLM_BACKEND=openrouter
SCHOOLMS_OPENROUTER_API_KEY=
SCHOOLMS_OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# Deterministic seed
SCHOOLMS_SEED=42

# Comma-separated CORS origins the API accepts (UI domains). Defaults cover
# local dev; extend when hosting the UI on Vercel / Pages / a real domain.
SCHOOLMS_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- TLS / Caddy (docker compose --profile tls up) ---
# Reverse-proxy front (caddy/Caddyfile). Leave CADDY_DOMAIN empty in dev to
# default to localhost:8081; set it to a real domain for automatic HTTPS.
CADDY_DOMAIN=
# Published Caddy ports on the host.
CADDY_HTTPS_PORT=443
CADDY_HTTP_PORT=80
# Optional SNI override passed into the Caddy service.
CADDY_SNI=

# --- Secrets (required in production) ---
# SMS provider key (only used when a real SMS backend is configured).
SCHOOLMS_SMS_API_KEY=
# Communication backend: log (dev default, writes to stdout) | sms
SCHOOLMS_COMMS_BACKEND=log
# PRODUCTION: set SCHOOLMS_JWT_SECRET to a real, high-entropy secret.
#   It must be a genuine random value of 32+ bytes (256+ bits). Examples:
#     $ openssl rand -hex 32          # 64 hex chars = 32 bytes
#     $ python -c "import secrets;print(secrets.token_hex(32))"
#   The 'dev-secret-change-me' placeholder in this file is ONLY for local
#   development. Do NOT ship a weak or predictable JWT secret to prod.
